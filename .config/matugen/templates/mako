anchor=top-right
margin=16,16,0,0
padding=12
width=350
height=150
border-size=2
border-radius=8
layer=overlay
font=JetBrainsMono Nerd Font 11
icons=1
max-icon-size=48
default-timeout=5000
ignore-timeout=1

# --- Colors (Matugen) ---
background-color={{colors.background.default.hex}}
text-color={{colors.on_background.default.hex}}
border-color={{colors.primary.default.hex}}
progress-color=over {{colors.surface_variant.default.hex}}

[urgency=low]
border-color={{colors.outline.default.hex}}
default-timeout=3000

[urgency=critical]
border-color={{colors.error.default.hex}}
default-timeout=0